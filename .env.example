# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-sonnet-5-5     # any tool-calling model id for your provider
LLM_API_KEY=

SARVAM_API_KEY=                 # unused (voice input was dropped)

DB_PATH=app/data/bank.db
API_URL=http://localhost:8000   # used by the Streamlit UI

# Optional: shown in the UI header (docs/UI.md)
YS_OFFICER_ID=officer-1         # officer id sent with approve / reject
YS_OFFICER_NAME=Officer 1
YS_BRANCH=Mandya (demo branch)
