    {
      "id": "PMKISAN_DBT",
      "name": "PM-KISAN DBT readiness",
      "category": "dbt",
      "benefit": "₹6,000 per year in three instalments to landholding farmer families",
      "value_inr": 6000,
      "value_basis": "income support per year",
      "rules": {
        "all": [
          {
            "id": "R-PMK-FARMER",
            "field": "occupation",
            "op": "==",
            "value": "farmer",
            "text": "Must be a farmer"
          },
          {
            "id": "R-PMK-LAND",
            "field": "is_landholder",
            "op": "is_true",
            "text": "Must own cultivable land"
          },
          {
            "id": "R-PMK-NOT-ITP",
            "field": "is_income_tax_payer",
            "op": "is_false",
            "text": "Income-tax payers are excluded"
          },
          {
            "id": "R-PMK-NOT-GOVT",
            "field": "is_govt_employee",
            "op": "is_false",
            "text": "Serving or retired government employees are excluded (except Group D / MTS)"
          },
          {
            "id": "R-PMK-NOT-PROF",
            "field": "is_registered_professional",
            "op": "is_false",
            "text": "Registered professionals (doctor, engineer, lawyer, CA, architect) are excluded"
          },
          {
            "id": "R-PMK-PENSION",
            "field": "monthly_pension",
            "op": "<",
            "value": 10000,
            "text": "Pensioners receiving ₹10,000 or more per month are excluded"
          }
        ]
      },
      "prerequisites": [
        {
          "field": "has_savings_account",
          "op": "is_true",
          "action": "OPEN_SAVINGS_ACCOUNT"
        },
        {
          "field": "aadhaar_seeded",
          "op": "is_true",
          "action": "AADHAAR_SEEDING_REQUEST"
        },
        {
          "field": "ekyc_done",
          "op": "is_true",
          "action": "EKYC_REQUEST"
        }
      ],
      "required_docs": [
        "AADHAAR",
        "RTC",
        "PASSBOOK"
      ],
      "source_url": "https://pmkisan.gov.in",
      "last_verified": "TODO"
    },
