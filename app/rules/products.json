    {
      "id": "SSY",
      "name": "Sukanya Samriddhi Yojana",
      "category": "savings",
      "benefit": "Tax-advantaged savings account for a girl child",
      "value_inr": null,
      "value_basis": "depends on deposits",
      "rules": {
        "all": [
          {
            "id": "R-SSY-GIRL",
            "field": "girl_children_under_10",
            "op": ">=",
            "value": 1,
            "text": "Must be parent/guardian of a girl child below 10 years"
          },
          {
            "id": "R-SSY-MAX2",
            "field": "existing_ssy_accounts",
            "op": "<",
            "value": 2,
            "text": "A family may hold at most 2 SSY accounts"
          }
        ]
      },
      "prerequisites": [],
      "required_docs": [
        "GIRL_BIRTH_CERT",
        "AADHAAR",
        "PHOTO",
        "ADDRESS_PROOF"
      ],
      "source_url": "https://www.nsiindia.gov.in",
      "last_verified": "TODO"
