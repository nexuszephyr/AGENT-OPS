      "id": "PMJDY",
      "name": "Pradhan Mantri Jan Dhan Yojana",
      "category": "account",
      "benefit": "Zero-balance savings account with RuPay card",
      "value_inr": null,
      "value_basis": "savings account (no single value)",
      "rules": {
        "all": [
          {
            "id": "R-PMJDY-NO-ACCT",
            "field": "has_savings_account",
            "op": "is_false",
            "text": "Customer must not already hold a savings account"
          },
          {
            "id": "R-PMJDY-AGE-MIN",
            "field": "age",
            "op": ">=",
            "value": 10,
            "text": "Age must be 10 or above"
          }
        ]
      },
      "prerequisites": [],
      "required_docs": [
        "AADHAAR",
        "PHOTO"
      ],
      "source_url": "https://pmjdy.gov.in",
